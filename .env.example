# Innovation Lab Frontend Environment Variables
# Copy this file to .env.local and fill in the values
# SECURITY: Never commit .env.local or any file with real credentials

# ======================
# Required Configuration
# ======================

# Database connection string (PostgreSQL)
# Production: Use connection pooling and SSL
# Example: postgres://user:password@host:5432/database?sslmode=require
DATABASE_URL=postgres://user:password@localhost:5432/innovationlab

# ======================
# Production Configuration
# ======================

# Environment (development | production)
NODE_ENV=development

# Base URL for the application (REQUIRED for production)
# Used in SEO, canonical URLs, sitemaps, emails, etc.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API base URL (defaults to same origin if not set)
NEXT_PUBLIC_API_BASE_URL=

# ======================
# Database Configuration
# ======================

# Enable SSL for database connections (REQUIRED for production)
POSTGRES_SSL=false

# Connection pool size (adjust based on your hosting plan)
POSTGRES_POOL_SIZE=10

# ======================
# Authentication & Security
# ======================

# Initial Admin User (for db:seed)
# REQUIRED when running: npm run db:seed
ADMIN_EMAIL=admin@innovationlab.com
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Admin

# Session max age in seconds (default: 7 days = 604800)
# For higher security: 24 hours = 86400
AUTH_SESSION_MAX_AGE=604800

# bcrypt salt rounds (higher = more secure but slower)
# Recommended: 10-12 for production
AUTH_BCRYPT_SALT_ROUNDS=10

# Secure cookie settings (auto-enabled in production)
# Set to "true" to force secure cookies in development
AUTH_SECURE_COOKIES=false

# Allowed origins for CORS (comma-separated)
# Example: https://yourdomain.com,https://admin.yourdomain.com
ALLOWED_ORIGINS=

# ======================
# Rate Limiting
# ======================

# Enable rate limiting (default: true in production)
RATE_LIMIT_ENABLED=true

# Redis URL for distributed rate limiting (optional)
# Required if running multiple instances
REDIS_URL=

# ======================
# External Services
# ======================

# Cloudinary (for file/image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Service (for contact forms, notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com